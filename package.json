{
  "name": "@defra/forms-common",
  "version": "0.1.0",
  "description": "Cross-cutting framework code shared by the Defra forms services",
  "homepage": "https://github.com/DEFRA/forms-common#readme",
  "types": "dist/types/index.d.ts",
  "main": "dist/module/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/module/index.js",
      "default": "./dist/module/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/forms-common.git"
  },
  "license": "OGL-UK-3.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run build:types && npm run build:node",
    "build:node": "babel --delete-dir-on-start --ignore \"**/*.test.*\" --copy-files --no-copy-ignored --source-maps --out-dir ./dist/module ./src",
    "build:types": "tsc --build --force tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --cache --cache-location .cache/prettier --cache-strategy content --check \"**/*.{cjs,js,json,md,mjs,ts}\"",
    "lint": "npm run lint:editorconfig && npm run lint:js && npm run lint:types",
    "lint:editorconfig": "editorconfig-checker",
    "lint:fix": "npm run lint:js -- --fix",
    "lint:js": "eslint --cache --cache-location .cache/eslint --cache-strategy content --color .",
    "lint:types": "tsc --noEmit",
    "prepare": "husky || true",
    "test": "jest --color --coverage --verbose",
    "test:watch": "jest --color --watch"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@defra/hapi-tracing": "^1.30.0",
    "@hapi/hapi": "^21.4.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-replace-import-extension": "^1.1.5",
    "editorconfig-checker": "^6.2.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^63.0.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.7",
    "neostandard": "^0.12.2",
    "pino": "^10.3.1",
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.56.1"
  },
  "peerDependencies": {
    "@hapi/hapi": "^21.0.0",
    "pino": "^10.0.0"
  },
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0 || >=12.0.2"
  },
  "allowScripts": {
    "@defra/hapi-tracing": true,
    "unrs-resolver": true
  }
}
